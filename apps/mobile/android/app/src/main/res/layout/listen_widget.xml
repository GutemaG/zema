<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/listen_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageButton
        android:id="@+id/listen_widget_mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/listen_widget_mic_background"
        android:contentDescription="@string/listen_widget_mic"
        android:scaleType="center"
        android:src="@drawable/ic_listen_mic"
        android:tint="#1E1814" />

    <LinearLayout
        android:id="@+id/listen_widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/listen_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F3EBDD"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listen_widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B5A898"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
